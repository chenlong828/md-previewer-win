<Window x:Class="MDPreview.Win.Shell.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MDPreview" Width="1080" Height="760" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBg}" AllowDrop="True">
    <Window.Resources>
        <SolidColorBrush x:Key="ChromeBg" Color="#FFF6F6F6" />
        <SolidColorBrush x:Key="ChromeFg" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="ChromeBorder" Color="#FFE3E3E3" />
        <SolidColorBrush x:Key="PageBg" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="MutedFg" Color="#FF666666" />

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeFg}" />
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" BorderThickness="0,0,0,1" />
        <StatusBar DockPanel.Dock="Bottom" Height="26" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <TextBlock x:Name="StatsText" Foreground="{DynamicResource MutedFg}" FontSize="12" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="StateText" Foreground="{DynamicResource MutedFg}" FontSize="12" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DrawerColumn" Width="0" />
                <ColumnDefinition x:Name="SplitColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DrawerPanel" Grid.Column="0" Background="{DynamicResource ChromeBg}"
                    BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource ChromeBorder}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="DrawerHomeButton" DockPanel.Dock="Right" Content="⌂" Width="24"
                                    ToolTip="跳到用户目录" FontSize="13" Padding="0" Click="OnDrawerHomeClick"
                                    Foreground="{DynamicResource ChromeFg}" Background="Transparent"
                                    BorderBrush="{DynamicResource ChromeBorder}" />
                            <Button x:Name="DrawerUpButton" DockPanel.Dock="Right" Content="↑" Width="24"
                                    ToolTip="上一级目录" FontSize="13" Margin="2,0" Padding="0" Click="OnDrawerUpClick"
                                    Foreground="{DynamicResource ChromeFg}" Background="Transparent"
                                    BorderBrush="{DynamicResource ChromeBorder}" />
                            <TextBlock x:Name="DrawerRootText" Text="文件" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ChromeFg}" />
                        </DockPanel>
                    </Border>
                    <TreeView x:Name="DrawerTree" BorderThickness="0" Background="Transparent"
                              Foreground="{DynamicResource ChromeFg}"
                              FontSize="12" Padding="2,4" MouseDoubleClick="OnDrawerDoubleClick" />
                </DockPanel>
            </Border>

            <GridSplitter x:Name="DrawerSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"
                          DragCompleted="OnDrawerSplitterDragCompleted" />

            <Grid Grid.Column="2">
                <wv2:WebView2 x:Name="Web" />
                <Border x:Name="Overlay" Background="{DynamicResource PageBg}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="OverlayText" Text="正在加载编辑器…" FontSize="14"
                                   Foreground="{DynamicResource MutedFg}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
